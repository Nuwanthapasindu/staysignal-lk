PORT=5000
MONGO_URI=mongodb://localhost:27017/staysignal
CLIENT_ORIGIN=http://localhost:5173

# Auth — generate long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional: separate database used by `npm test` (collections are dropped between tests)
MONGO_URI_TEST=mongodb://localhost:27017/staysignal-lk-test
